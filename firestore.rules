rules_version = '2';

// Deploy: firebase deploy --only firestore:rules
// Console: Firebase → Firestore → Rules

service cloud.firestore {
  match /databases/{database}/documents {

    // Query audit (indexes: firestore.indexes.json; empty = single-field defaults):
    // users/{uid}/activities: where timestamp >= T + orderBy timestamp desc — Workout, Progress
    // users/{uid}/activities: orderBy timestamp desc — Profile, ActivityMonitoring
    // users/{uid}/sessions: where timestamp >= T + orderBy timestamp desc — Progress
    // users/{uid}/sessions: orderBy timestamp desc — Train
    // users/{uid}/metrics: where timestamp >= T + orderBy timestamp desc — Progress
    // users/{uid}/metrics: orderBy timestamp desc — Metrics
    // users/{uid}/routines: orderBy updatedAt desc — Routines, Train
    // users/{uid}/workoutPlans: collection onSnapshot — PlanList

    // Per-user data: activities, sessions, metrics, routines, workoutPlans, profile, etc.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
